@model Employee
@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Employee</h1>

<br />
<br />


<form asp-action="Edit">
    <div class="form-group">



        <div class="my-3">
            <label asp-for="Name" class="col-form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name"></span>
        </div>
        <div class="my-3">
            <label asp-for="Age" class="col-form-label"></label>
            <input asp-for="Age" class="form-control" type="number" />
            <span asp-validation-for="Age"></span>
        </div>
        <div class="my-3">
            <label asp-for="Email" class="col-form-label"></label>
            <input asp-for="Email" class="form-control" type="email" />
            <span asp-validation-for="Email"></span>
        </div>
        <div class="my-3">
            <label asp-for="Address" class="col-form-label"></label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address"></span>
        </div>
        <div class="my-3">
            <label asp-for="Phone" class="col-form-label"></label>
            <input asp-for="Phone" class="form-control" type="tel" />
            <span asp-validation-for="Phone"></span>
        </div>
        <div class="my-3">
            <label asp-for="Salary" class="col-form-label"></label>
            <input asp-for="Salary" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="Salary"></span>
        </div>
        <div class="my-3">
            <label asp-for="IsActive" class="col-form-label"></label>
            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
            <span asp-validation-for="IsActive"></span>
        </div>
        <div class="my-3">
            <label asp-for="IsDeleted" class="col-form-label"></label>
            <input asp-for="IsDeleted" class="form-check-input" type="checkbox" />
            <span asp-validation-for="IsDeleted"></span>
        </div>
        <div class="my-3">
            <label asp-for="HiringDate" class="col-form-label"></label>
            <input asp-for="HiringDate" class="form-control" type="date" />
            <span asp-validation-for="HiringDate"></span>
        </div>

    <input type="submit" value="Save" class="btn btn-primary my-5" />
    <a asp-controller="Employee" asp-action="Index" class="btn btn-light my-5">Back To List</a>
</form>