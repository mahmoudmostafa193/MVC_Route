@model Employee

@{
    ViewData["Title"] = "Delate";
}

<h1>Delate Employee:</h1>
<br />
<br />


<form asp-action="Delete">
   
        <div class="my-3">
            <label asp-for="Name" class="col-form-label"></label>
            <input asp-for="Name" class="form-control" readonly/>

        </div>
        <div class="my-3">
            <label asp-for="Age" class="col-form-label"></label>
            <input asp-for="Age" class="form-control" type="number" readonly/>
          
        </div>
        <div class="my-3">
            <label asp-for="Email" class="col-form-label"></label>
            <input asp-for="Email" class="form-control" type="email" readonly/>
            
        </div>
        <div class="my-3">
            <label asp-for="Address" class="col-form-label"></label>
            <input asp-for="Address" class="form-control" readonly/>
        
        </div>
        <div class="my-3">
            <label asp-for="Phone" class="col-form-label"></label>
            <input asp-for="Phone" class="form-control" type="tel" readonly/>
           
        </div>
        <div class="my-3">
            <label asp-for="Salary" class="col-form-label"></label>
            <input asp-for="Salary" class="form-control" type="number" step="0.01" readonly/>
            
        </div>
        <div class="my-3">
            <label asp-for="IsActive" class="col-form-label"></label>
            <input asp-for="IsActive" class="form-check-input" type="checkbox"readonly disabled />
          
        </div>
        <div class="my-3">
            <label asp-for="IsDeleted" class="col-form-label"></label>
            <input asp-for="IsDeleted" class="form-check-input" type="checkbox" readonly disabled/>
          
        </div>
        <div class="my-3">
            <label asp-for="HiringDate" class="col-form-label"></label>
            <input asp-for="HiringDate" class="form-control" type="date" readonly/>
          
        </div>
    <div class="my-3">
        <label asp-for="Department" class="col-form-label"></label>
        <input asp-for="Department" class="form-control" readonly />
    </div>
        <div>
            <input type="submit" value="Delete" class="btn btn-primary" />
        </div>

   
</form>

